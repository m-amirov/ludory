@@ -0,0 +1,72 @@
+import { describe, expect, test } from "bun:test";
+import {
+  BROWSER_OBSERVATION_V2_FEATURE,
+  canonicalBrowserModel,
+  parseBrowserObservationV2,
+} from "../src/adapters/chatgpt-web/browser-observation";
+
+const sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+
+function validObservation() {
+  return {
+    version: 2,
+    traceId: "turn_0123456789abcdef0123456789abcdef",
+    source: "chatgpt-web-browser",
+    model: {
+      canonicalId: "chatgpt-web/gpt-6-sol",
+      backendModelId: "gpt-5.6-sol",
+      family: "6",
+      effort: "high",
+      selectionLabel: "High",
+    },
+    attachments: [{
+      ref: "hero-expression",
+      name: "hero-expression.png",
+      mimeType: "image/png",
+      sha256,
+      bytes: 12345,
+      upload: {
+        creationRequestObserved: true,
+        processingRequestObserved: true,
+        processingRequestKind: "process_upload_stream",
+        processingEvent: "file.processing.completed",
+        processingCompleted: true,
+        visibleAttachmentChip: true,
+      },
+    }],
+  };
+}
+
+describe("browser_observation_v2 contract", () => {
+  test("advertises a versioned feature and derives Sol routes from browser selection", () => {
+    expect(BROWSER_OBSERVATION_V2_FEATURE).toBe("browser_observation_v2");
+    expect(canonicalBrowserModel("6", "high")).toBe("chatgpt-web/gpt-6-sol");
+    expect(canonicalBrowserModel("6", "low")).toBe("chatgpt-web/gpt-6-sol-instant");
+    expect(canonicalBrowserModel("6", "max")).toBe("chatgpt-web/gpt-6-pro");
+  });
+
+  test("accepts the complete browser-owned observation shape", () => {
+    expect(parseBrowserObservationV2(validObservation())).toEqual(validObservation() as any);
+  });
+
+  test("rejects missing upload proof, mismatched trace, and unknown model fields", () => {
+    const missingProof = structuredClone(validObservation()) as any;
+    delete missingProof.attachments[0].upload.visibleAttachmentChip;
+    expect(() => parseBrowserObservationV2(missingProof)).toThrow();
+
+    const wrongTrace = structuredClone(validObservation()) as any;
+    wrongTrace.traceId = "turn_other";
+    expect(() => parseBrowserObservationV2(wrongTrace, { traceId: "turn_0123456789abcdef0123456789abcdef" })).toThrow();
+
+    const unknownField = structuredClone(validObservation()) as any;
+    unknownField.model.agentDeclared = true;
+    expect(() => parseBrowserObservationV2(unknownField)).toThrow();
+  });
+
+  test("rejects GPT-6 Astra/Pro as a Sol observation", () => {
+    const pro = structuredClone(validObservation()) as any;
+    pro.model.canonicalId = "chatgpt-web/gpt-6-pro";
+    pro.model.effort = "max";
+    expect(() => parseBrowserObservationV2(pro, { requireCanonicalModel: "chatgpt-web/gpt-6-sol" })).toThrow();
+  });
+});

