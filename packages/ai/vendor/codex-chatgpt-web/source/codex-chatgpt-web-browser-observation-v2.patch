diff --git a/src/adapters/chatgpt-web/browser-observation.ts b/src/adapters/chatgpt-web/browser-observation.ts
new file mode 100644
index 0000000..7edef42
--- /dev/null
+++ b/src/adapters/chatgpt-web/browser-observation.ts
@@ -0,0 +1,124 @@
+export const BROWSER_OBSERVATION_V2_FEATURE = "browser_observation_v2" as const;
+export const BROWSER_OBSERVATION_CALLBACK_TIMEOUT_MS = 10_000;
+
+export type BrowserModelFamily = "5.6" | "6";
+export type BrowserModelEffort = "low" | "medium" | "high" | "xhigh" | "max";
+
+export interface BrowserObservationV2Upload {
+  creationRequestObserved: true;
+  processingRequestObserved: true;
+  processingRequestKind: "process_upload_stream" | "claim_and_finish";
+  processingEvent: "file.processing.completed";
+  processingCompleted: true;
+  visibleAttachmentChip: true;
+}
+
+export interface BrowserObservationV2Attachment {
+  ref: string;
+  name: string;
+  mimeType: "image/png" | "image/jpeg" | "image/gif" | "image/webp";
+  sha256: string;
+  bytes: number;
+  upload: BrowserObservationV2Upload;
+}
+
+export interface BrowserObservationV2 {
+  version: 2;
+  traceId: string;
+  source: "chatgpt-web-browser";
+  model: {
+    canonicalId: string;
+    backendModelId: string;
+    family: BrowserModelFamily;
+    effort: BrowserModelEffort;
+    selectionLabel: string;
+  };
+  attachments: BrowserObservationV2Attachment[];
+}
+
+export class BrowserObservationV2Error extends Error {
+  readonly code = "BROWSER_OBSERVATION_V2_INVALID";
+}
+
+const fail = (message: string): never => { throw new BrowserObservationV2Error(message); };
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  Boolean(value) && typeof value === "object" && !Array.isArray(value);
+const exactKeys = (value: Record<string, unknown>, keys: readonly string[]): void => {
+  const allowed = new Set(keys);
+  if (Object.keys(value).some(key => !allowed.has(key))) fail("unknown observation field");
+};
+const stringValue = (value: unknown, field: string, pattern?: RegExp): string => {
+  if (typeof value !== "string" || value.length === 0 || (pattern && !pattern.test(value))) {
+    fail(`invalid observation ${field}`);
+  }
+  return value as string;
+};
+
+export function canonicalBrowserModel(family: BrowserModelFamily, effort: BrowserModelEffort): string {
+  if (effort === "low") return `chatgpt-web/gpt-${family}-sol-instant`;
+  if (effort === "max") return `chatgpt-web/gpt-${family}-pro`;
+  return `chatgpt-web/gpt-${family}-sol`;
+}
+
+export function parseBrowserObservationV2(
+  value: unknown,
+  options: { traceId?: string; requireCanonicalModel?: string } = {},
+): BrowserObservationV2 {
+  if (!isRecord(value)) fail("observation is not an object");
+  const record = value as Record<string, unknown>;
+  exactKeys(record, ["version", "traceId", "source", "model", "attachments"]);
+  if (record.version !== 2 || record.source !== "chatgpt-web-browser") fail("observation envelope invalid");
+  const traceId = stringValue(record.traceId, "traceId", /^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$/);
+  if (options.traceId !== undefined && traceId !== options.traceId) fail("observation trace mismatch");
+  if (!isRecord(record.model)) fail("observation model invalid");
+  const model = record.model as Record<string, unknown>;
+  exactKeys(model, ["canonicalId", "backendModelId", "family", "effort", "selectionLabel"]);
+  const family = model.family as BrowserModelFamily;
+  const effort = model.effort as BrowserModelEffort;
+  if (family !== "5.6" && family !== "6") fail("observation family invalid");
+  if (!(effort === "low" || effort === "medium" || effort === "high" || effort === "xhigh" || effort === "max")) {
+    fail("observation effort invalid");
+  }
+  const canonicalId = stringValue(model.canonicalId, "model.canonicalId");
+  if (canonicalId !== canonicalBrowserModel(family, effort)) fail("observation canonical model mismatch");
+  if (options.requireCanonicalModel !== undefined && canonicalId !== options.requireCanonicalModel) {
+    fail("observation model policy mismatch");
+  }
+  const backendModelId = stringValue(model.backendModelId, "model.backendModelId");
+  const selectionLabel = stringValue(model.selectionLabel, "model.selectionLabel");
+  if (!Array.isArray(record.attachments) || record.attachments.length < 1 || record.attachments.length > 10) {
+    fail("observation attachments invalid");
+  }
+  const refs = new Set<string>();
+  const names = new Set<string>();
+  const attachments = (record.attachments as unknown[]).map((valueAttachment: unknown) => {
+    if (!isRecord(valueAttachment)) fail("observation attachment invalid");
+    const attachment = valueAttachment as Record<string, unknown>;
+    exactKeys(attachment, ["ref", "name", "mimeType", "sha256", "bytes", "upload"]);
+    const ref = stringValue(attachment.ref, "attachment.ref", /^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$/);
+    const name = stringValue(attachment.name, "attachment.name", /^[^\\/\0]{1,240}$/);
+    if (refs.has(ref) || names.has(name)) fail("observation attachment identity collision");
+    refs.add(ref); names.add(name);
+    if (!(attachment.mimeType === "image/png" || attachment.mimeType === "image/jpeg" ||
+        attachment.mimeType === "image/gif" || attachment.mimeType === "image/webp")) {
+      fail("observation attachment mime invalid");
+    }
+    const sha256 = stringValue(attachment.sha256, "attachment.sha256", /^[a-f0-9]{64}$/);
+    if (!Number.isSafeInteger(attachment.bytes) || (attachment.bytes as number) < 1) {
+      fail("observation attachment size invalid");
+    }
+    if (!isRecord(attachment.upload)) fail("observation upload invalid");
+    const upload = attachment.upload as Record<string, unknown>;
+    exactKeys(upload, ["creationRequestObserved", "processingRequestObserved", "processingRequestKind", "processingEvent", "processingCompleted", "visibleAttachmentChip"]);
+    if (upload.creationRequestObserved !== true || upload.processingRequestObserved !== true ||
+        upload.processingCompleted !== true || upload.visibleAttachmentChip !== true ||
+        upload.processingEvent !== "file.processing.completed" ||
+        !(upload.processingRequestKind === "process_upload_stream" || upload.processingRequestKind === "claim_and_finish")) {
+      fail("observation upload proof incomplete");
+    }
+    return { ref, name, mimeType: attachment.mimeType as BrowserObservationV2Attachment["mimeType"],
+      sha256, bytes: attachment.bytes as number, upload: upload as unknown as BrowserObservationV2Upload };
+  });
+  return { version: 2, traceId, source: "chatgpt-web-browser",
+    model: { canonicalId, backendModelId, family, effort, selectionLabel }, attachments };
+}
