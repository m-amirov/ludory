+      const parsed = image.imageUrl.split(',')[1];
+      const bytes = Buffer.from(parsed, 'base64');
+      await turn.onBrowserObservationV2({version:2, traceId:turn.traceId, source:'chatgpt-web-browser',
+        model:{canonicalId:'chatgpt-web/gpt-6-sol',backendModelId:'gpt-5.6-sol',family:'6',effort:'high',selectionLabel:'High'},
+        attachments:[{ref:image.ref,name:'candidate.png',mimeType:'image/png',sha256:${JSON.stringify(createHash("sha256").update(Buffer.from("v2-image")).digest("hex"))},bytes:bytes.length,
+          upload:{creationRequestObserved:true,processingRequestObserved:true,processingRequestKind:'process_upload_stream',processingEvent:'file.processing.completed',processingCompleted:true,visibleAttachmentChip:true}}]});
+      await turn.onSendActivated(); turn.onSubmitted(); return 'independent response';
+    };
+    await import(${JSON.stringify(main)});
+  `);
+  const client = new LauncherBrowserHelperClient(configFor(root, helper));
+  try {
+    const run = validTurn("abcdef123456", async () => { await new Promise(resolve => setTimeout(resolve, 25)); });
